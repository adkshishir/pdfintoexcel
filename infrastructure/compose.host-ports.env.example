# Copy to `compose.host-ports.env` (gitignored) — `make prod-up` loads it automatically.
# Host-published ports for Docker backend/frontend; must match your host nginx upstreams.
# Defaults in docker-compose.prod.yml are 4017 / 4018 (after 4016) if this file is absent.

HOST_PORT_BACKEND=4017
HOST_PORT_FRONTEND=4018
