# Production env. Copy to `infrastructure/.env.prod` and fill in real values.
# Loaded by docker-compose.prod.yml. **Never commit `.env.prod`.**

# --- core ---
ENV=prod
LOG_LEVEL=INFO

# --- DB ---
# Use a strong password and a managed Postgres if you can.
POSTGRES_USER=converter
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_STRING
POSTGRES_DB=converter
DATABASE_URL=postgresql+psycopg://converter:CHANGE_ME_LONG_RANDOM_STRING@postgres:5432/converter

# --- redis ---
REDIS_URL=redis://redis:6379/0

# --- limits ---
MAX_UPLOAD_BYTES=31457280       # 30 MB
JOB_TTL_SECONDS=86400           # 24 h
JOB_TIMEOUT_SECONDS=600         # 10 min

# --- API ---
# In prod nginx fronts the API on the same origin as the frontend, so CORS
# can be locked down to your real domain.
# Apex + www (remove www if you don't use it)
CORS_ORIGINS=["https://pdfintoexcel.com","https://www.pdfintoexcel.com"]

# --- storage ---
STORAGE_BACKEND=oracle
STORAGE_BUCKET=converter-prod
ORACLE_ENDPOINT=https://<your-namespace>.compat.objectstorage.<region>.oraclecloud.com
ORACLE_REGION=ap-mumbai-1
ORACLE_ACCESS_KEY=
ORACLE_SECRET_KEY=

# --- pipeline ---
DEFAULT_MODE=fast
OCR_ENGINE=paddle
CELERY_CONCURRENCY=3
