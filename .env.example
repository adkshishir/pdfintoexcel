# Top-level env. Per-service env defaults live in:
#   backend/.env.example
# Frontend reads NEXT_PUBLIC_API_BASE_URL.

# Where the browser hits the API. Through nginx in compose, this is /api.
NEXT_PUBLIC_API_BASE_URL=/api

# Google Analytics 4 (optional — leave empty to disable)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
