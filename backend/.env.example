# Copy to .env and adjust. Values shown match the docker-compose defaults.

ENV=dev
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Limits
MAX_UPLOAD_BYTES=31457280       # 30 MB
JOB_TTL_SECONDS=86400           # 24 h
JOB_TIMEOUT_SECONDS=600         # 10 min

# Database
# In Docker (default for API/worker containers):
# DATABASE_URL=postgresql+psycopg://converter:converter@postgres:5432/converter
# Host-side scripts (seed, alembic) with `make up` — Postgres is published on :5433:
DATABASE_URL=postgresql+psycopg://converter:converter@localhost:5433/converter

# Queue
REDIS_URL=redis://redis:6379/0
CELERY_CONCURRENCY=2

# Storage — "local" for dev, "oracle" in prod
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/var/lib/converter/storage
STORAGE_BUCKET=converter
# Required when STORAGE_BACKEND=oracle:
# ORACLE_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# ORACLE_REGION=ap-mumbai-1
# ORACLE_ACCESS_KEY=
# ORACLE_SECRET_KEY=

# Pipeline
DEFAULT_MODE=fast
OCR_ENGINE=paddle

# Analytics API (`X-Analytics-Key` for /api/analytics/summary). Use a long random string in prod.
ANALYTICS_API_KEY=

# Admin auth (JWT + first-login bootstrap). Use strong secrets in production.
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
ADMIN_BOOTSTRAP_EMAIL=admin@pdfintoexcel.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-in-production
